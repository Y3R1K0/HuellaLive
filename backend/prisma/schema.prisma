generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  HUMAN
  SHELTER
  ADMIN
}

enum ShelterStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AnimalStatus {
  AVAILABLE
  RECOVERING
  PREGNANT
  ADOPTED
  OTHER
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  firebaseUid  String?  @unique
  avatarUrl    String?
  selectedBadgeId String?
  role         Role     @default(HUMAN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shelterProfile      ShelterProfile?
  videos              Video[]
  shelterStories      ShelterStory[]
  likes               Like[]
  videoViews          VideoView[]
  follows             Follow[]
  chatsAsHuman        Chat[]            @relation("HumanChats")
  messages            Message[]
  adoptionRequests    AdoptionRequest[]
  donations           Donation[]
  galletaTransactions GalletaTransaction[]
  animalFeeds         AnimalFeed[]
  badges              UserBadge[]
  notifications       Notification[]
  adoptedAnimals      Animal[]          @relation("AdoptedAnimals")
  reports             Report[]

  @@map("users")
}

model ShelterProfile {
  id               String        @id @default(uuid())
  userId           String        @unique
  user             User          @relation(fields: [userId], references: [id])
  coverUrl         String?
  description      String?
  location         String?
  latitude         Float?
  longitude        Float?
  phone            String?
  mercadoPagoAccessToken String?
  mercadoPagoPublicKey   String?
  mercadoPagoUserId      String?
  mercadoPagoRefreshToken String?
  mercadoPagoConnectedAt DateTime?
  mercadoPagoTokenExpiresAt DateTime?
  status           ShelterStatus @default(PENDING)
  verificationDocs String[]
  createdAt        DateTime      @default(now())

  animals          Animal[]
  chats            Chat[]        @relation("ShelterChats")
  donations        Donation[]
  withdrawals      ShelterWithdrawal[]
  stories          ShelterStory[]

  @@map("shelter_profiles")
}

model Animal {
  id                  String       @id @default(uuid())
  name                String
  species             String
  breed               String?
  age                 Int?
  description         String?
  photoUrl            String?
  status              AnimalStatus @default(AVAILABLE)
  credentialUsername  String       @unique
  credentialPassword  String
  shelterId           String?
  shelter             ShelterProfile? @relation(fields: [shelterId], references: [id])
  adoptedById         String?
  adoptedBy           User?        @relation("AdoptedAnimals", fields: [adoptedById], references: [id])
  adoptedByPublic     Boolean      @default(true)
  originalShelterId   String?
  createdAt           DateTime     @default(now())

  card             AnimalCard?
  videos           Video[]
  adoptionRequests AdoptionRequest[]
  animalFeeds      AnimalFeed[]

  @@map("animals")
}

model AnimalCard {
  id           String    @id @default(uuid())
  animalId     String    @unique
  animal       Animal    @relation(fields: [animalId], references: [id])
  sex          String?
  birthDate    DateTime?
  isSterilized Boolean   @default(false)
  vaccines     Json      @default("[]")
  controls     Json      @default("[]")
  notes        String?
  updatedAt    DateTime  @updatedAt

  @@map("animal_cards")
}

model Video {
  id           String   @id @default(uuid())
  videoUrl     String
  thumbnailUrl String?
  description  String
  likesCount   Int      @default(0)
  createdAt    DateTime @default(now())

  animalId     String
  animal       Animal @relation(fields: [animalId], references: [id])
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  likes        Like[]
  views        VideoView[]
  reports      Report[]

  @@map("videos")
}

model ShelterStory {
  id           String   @id @default(uuid())
  videoUrl     String
  thumbnailUrl String?
  description  String
  createdAt    DateTime @default(now())

  shelterId    String
  shelter      ShelterProfile @relation(fields: [shelterId], references: [id])
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  @@index([shelterId, createdAt])
  @@map("shelter_stories")
}

model Report {
  id          String   @id @default(uuid())
  reporterId  String
  reporter    User     @relation(fields: [reporterId], references: [id])
  targetType  String
  targetId    String
  reason      String
  details     String?
  status      String   @default("PENDING")
  videoId     String?
  video       Video?   @relation(fields: [videoId], references: [id])
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@map("reports")
}

model VideoView {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
  @@index([userId, createdAt])
  @@map("video_views")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
  @@map("likes")
}

model Follow {
  id        String   @id @default(uuid())
  humanId   String
  human     User     @relation(fields: [humanId], references: [id])
  shelterId String
  createdAt DateTime @default(now())

  @@unique([humanId, shelterId])
  @@map("follows")
}

model Chat {
  id        String         @id @default(uuid())
  humanId   String
  human     User           @relation("HumanChats", fields: [humanId], references: [id])
  shelterId String
  shelter   ShelterProfile @relation("ShelterChats", fields: [shelterId], references: [id])
  createdAt DateTime       @default(now())

  messages         Message[]
  adoptionRequests AdoptionRequest[]

  @@unique([humanId, shelterId])
  @@map("chats")
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  content   String?
  mediaUrl  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("messages")
}

model AdoptionRequest {
  id        String   @id @default(uuid())
  animalId  String
  animal    Animal   @relation(fields: [animalId], references: [id])
  humanId   String
  human     User     @relation(fields: [humanId], references: [id])
  shelterId String
  chatId    String?
  chat      Chat?    @relation(fields: [chatId], references: [id])
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@map("adoption_requests")
}

model Donation {
  id           String   @id @default(uuid())
  humanId      String
  human        User     @relation(fields: [humanId], references: [id])
  shelterId    String
  shelter      ShelterProfile @relation(fields: [shelterId], references: [id])
  amount       Float
  currency     String   @default("HUELLITAS")
  developerCut Float
  shelterCut   Float
  marketplaceFee Float?
  mercadopagoPreferenceId String?
  mercadopagoPaymentId String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  @@map("donations")
}

model GalletaTransaction {
  id        String   @id @default(uuid())
  humanId   String
  human     User     @relation(fields: [humanId], references: [id])
  amount    Int
  type      String
  createdAt DateTime @default(now())

  @@map("galleta_transactions")
}

model AnimalFeed {
  id           String   @id @default(uuid())
  humanId      String
  human        User     @relation(fields: [humanId], references: [id])
  animalId     String
  animal       Animal   @relation(fields: [animalId], references: [id])
  amount       Int
  shelterCut   Float
  developerCut Float
  createdAt    DateTime @default(now())

  @@map("animal_feeds")
}

model Badge {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  iconUrl     String?
  tier        String
  activity    String
  threshold   Int
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  badgeId    String
  badge      Badge    @relation(fields: [badgeId], references: [id])
  assignedBy String?
  assignedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model WeeklyRanking {
  id              String   @id @default(uuid())
  userId          String
  weekStart       DateTime
  totalDonated    Float    @default(0)
  totalGalletas   Int      @default(0)
  sheltersHelped  Int      @default(0)
  animalsAdopted  Int      @default(0)
  rank            Int

  @@unique([userId, weekStart])
  @@map("weekly_rankings")
}

model ShelterWithdrawal {
  id              String   @id @default(uuid())
  shelterId       String
  shelter         ShelterProfile @relation(fields: [shelterId], references: [id])
  amount          Float
  status          String   @default("PENDING")
  accountHolder   String
  documentNumber  String
  bankName        String
  accountType     String
  accountNumber   String
  cci             String
  currency        String   @default("PEN")
  receiptUrl      String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  processedAt     DateTime?

  @@index([shelterId, status])
  @@map("shelter_withdrawals")
}

model SearchCity {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  region    String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("search_cities")
}

model SearchSpecies {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("search_species")
}

model SpeciesRequest {
  id            String   @id @default(uuid())
  requestedName String
  normalizedName String
  animalId      String   @unique
  shelterId     String
  requestedById String
  status        String   @default("PENDING")
  rejectionReason String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
  @@map("species_requests")
}

model GeocodingCache {
  id        String   @id @default(uuid())
  cacheKey  String   @unique
  kind      String
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("geocoding_cache")
}
